{
  "name": "jellyfish-backend",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "reset-db": "tsx src/resetDb.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/api",
    "test:security": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/security tests/permissions",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "coverage:sync-thresholds": "node scripts/sync-coverage-thresholds.cjs",
    "test:legacy": "tsx src/tests/runAll.ts",
    "test:legacy:security": "tsx src/tests/securityTests.ts",
    "test:legacy:complex-qa": "tsx src/tests/complexQaTests.ts",
    "test:legacy:auth-security": "tsx src/tests/authSecurityQaTests.ts",
    "test:legacy:refresh-auth": "tsx src/tests/refreshAuthQaTests.ts",
    "test:legacy:role-permission-refresh": "tsx src/tests/rolePermissionRefreshQaTests.ts",
    "complex-qa": "npm run test:legacy:complex-qa",
    "auth-security-qa": "npm run test:legacy:auth-security",
    "refresh-auth-qa": "npm run test:legacy:refresh-auth",
    "role-permission-refresh-qa": "npm run test:legacy:role-permission-refresh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
